public class Ejercicio10 {
    public static void main(String[] args) {
        // Variables declaradas como double para asegurar un resultado decimal
        double a = 18;
        double b = 7;
        double c = 5;

        // Cálculo según la fórmula R = (a + b) / c
        double R = (a + b) / c;

        // Mostrar resultado
        System.out.println("R: " + R);
    }
}